# ─── Local Development Dockerfile (used by docker-compose only) ──
# Railway/production uses the root Dockerfile, not this one.
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci

COPY . .

EXPOSE 3001

CMD ["npm", "run", "start:dev"]
