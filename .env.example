# ─── App ───────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@localhost:5432/pakverse

# ─── JWT ───────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_EXPIRATION=7d

# ─── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Cloudinary ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_actual_cloud_name_from_cloudinary_dashboard
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Ethereal for dev — auto-creates test account) ─
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@pakverse.pk

# ─── Rate Limiting ─────────────────────────────────
# TTL values are in MILLISECONDS
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Misc ──────────────────────────────────────────
BCRYPT_ROUNDS=12
