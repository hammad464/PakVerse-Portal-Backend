# ─── App ───────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@localhost:5432/pakverse

# ─── JWT ───────────────────────────────────────────
# Secret key used to sign JWT access tokens
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
# Expiration time for access tokens (uses 'ms' string format, e.g., '15m' for 15 minutes)
JWT_EXPIRATION=15m
# Secret key used to sign refresh tokens
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX_STRING
# Expiration time for refresh tokens (uses 'ms' string format, e.g., '7d' for 7 days)
JWT_REFRESH_EXPIRATION=7d

# ─── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Cloudinary ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_actual_cloud_name_from_cloudinary_dashboard
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Ethereal for dev — auto-creates test account) ─
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@pakverse.pk

# ─── Rate Limiting ─────────────────────────────────
# Rate limiter TTL (Time To Live) — value is in MILLISECONDS
# 60000 = 60 seconds (1 minute) per window
THROTTLE_TTL=60000

# Maximum requests allowed within the TTL window per IP address
THROTTLE_LIMIT=100

# ─── Misc ──────────────────────────────────────────
BCRYPT_ROUNDS=12
